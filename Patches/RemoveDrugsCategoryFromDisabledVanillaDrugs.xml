<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Strip Drugs category / trade / loot hooks from disabled vanilla drugs so they
       don't appear in StockGenerator_Category, RandomDrugs, or similar lists.
       Parent DrugBase still supplies Drugs category + tradeTags unless Inherit="False".
       PsychiteTea is Social (not Hard) but still in Drugs; Khan Chem Dealer and similar
       traders use StockGenerator_Category Drugs and would keep stocking it otherwise. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="PsychiteTea"]/ingestible/drugCategory</xpath>
    <value>
      <drugCategory>None</drugCategory>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="PsychiteTea"]</xpath>
    <value>
      <thingCategories Inherit="False" />
      <tradeTags Inherit="False" />
      <thingSetMakerTags Inherit="False" />
      <tradeability>None</tradeability>
    </value>
  </Operation>
  <!-- Flake, Yayo, Wake-up: full disable like Go-Juice.
       drugCategory Hard also keeps them in RandomDrugs / IsDrug loot pools.
       Explicit thingDefs lists are replaced below. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Flake" or defName="Yayo" or defName="WakeUp"]/ingestible/drugCategory</xpath>
    <value>
      <drugCategory>None</drugCategory>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Flake" or defName="Yayo" or defName="WakeUp"]</xpath>
    <value>
      <thingCategories Inherit="False" />
      <tradeTags Inherit="False" />
      <thingSetMakerTags Inherit="False" />
      <tradeability>None</tradeability>
    </value>
  </Operation>

  <!-- GoJuice (Greenway: "distilled brahmin shrooms"): full disable like AUR/extract draughts.
       Parent DrugBase still supplies Drugs category + tradeTags unless Inherit="False";
       drugCategory Hard also keeps it in RandomDrugs / IsDrug loot pools. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="GoJuice"]/ingestible/drugCategory</xpath>
    <value>
      <drugCategory>None</drugCategory>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="GoJuice"]</xpath>
    <value>
      <thingCategories Inherit="False" />
      <tradeTags Inherit="False" />
      <thingSetMakerTags Inherit="False" />
      <tradeability>None</tradeability>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingSetMakerDef[defName="PirateRaidLootMaker"]//thingDefs/li[.="GoJuice"]</xpath>
  </Operation>
  <!-- Pirate raid loot (also used by FIP Raider Mutant Army via HHTools_Raider).
       Flake => Jet, Yayo => Ultrajet, Wake-up => Mentats, Luciferium => X-Cell. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingSetMakerDef[defName="PirateRaidLootMaker"]//thingDefs/li[.="Flake"]</xpath>
    <value><li>FCP_Chem_Jet</li></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingSetMakerDef[defName="PirateRaidLootMaker"]//thingDefs/li[.="Yayo"]</xpath>
    <value><li>FCP_Chem_Ultrajet</li></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingSetMakerDef[defName="PirateRaidLootMaker"]//thingDefs/li[.="WakeUp"]</xpath>
    <value><li>FCP_Chem_Mentats</li></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingSetMakerDef[defName="PirateRaidLootMaker"]//thingDefs/li[.="Luciferium"]</xpath>
    <value><li>FCP_Chem_X_Cell</li></value>
  </Operation>
  <!-- VFE Pirates is optional. MayRequire on Operation is not consulted while
       patches load, so a missing loot maker logs an xpath error. Test first. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingSetMakerDef[defName="VFEP_JunkersRaidLootMaker"]//thingDefs/li[.="GoJuice"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/ThingSetMakerDef[defName="VFEP_JunkersRaidLootMaker"]//thingDefs/li[.="GoJuice"]</xpath>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingSetMakerDef[defName="VFEP_JunkersRaidLootMaker"]//thingDefs/li[.="Flake"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingSetMakerDef[defName="VFEP_JunkersRaidLootMaker"]//thingDefs/li[.="Flake"]</xpath>
      <value><li>FCP_Chem_Jet</li></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingSetMakerDef[defName="VFEP_JunkersRaidLootMaker"]//thingDefs/li[.="Yayo"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingSetMakerDef[defName="VFEP_JunkersRaidLootMaker"]//thingDefs/li[.="Yayo"]</xpath>
      <value><li>FCP_Chem_Ultrajet</li></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingSetMakerDef[defName="VFEP_JunkersRaidLootMaker"]//thingDefs/li[.="WakeUp"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingSetMakerDef[defName="VFEP_JunkersRaidLootMaker"]//thingDefs/li[.="WakeUp"]</xpath>
      <value><li>FCP_Chem_Mentats</li></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingSetMakerDef[defName="VFEP_JunkersRaidLootMaker"]//thingDefs/li[.="Luciferium"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingSetMakerDef[defName="VFEP_JunkersRaidLootMaker"]//thingDefs/li[.="Luciferium"]</xpath>
      <value><li>FCP_Chem_X_Cell</li></value>
    </match>
  </Operation>

  <!-- Penoxycyline: same full category clear; otherwise Drugs StockGenerator_Category still stocks it. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Penoxycyline"]</xpath>
    <value>
      <thingCategories Inherit="False" />
      <tradeTags Inherit="False" />
      <thingSetMakerTags Inherit="False" />
      <tradeability>None</tradeability>
    </value>
  </Operation>
  <!-- Luciferium has its own tradeTags. thingSetMakerTags are cleared in RemoveLuciferiumFromLootCrates. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Luciferium"]/ingestible/drugCategory</xpath>
    <value>
      <drugCategory>None</drugCategory>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Luciferium"]/tradeTags</xpath>
    <value>
      <tradeTags Inherit="False" />
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Luciferium"]</xpath>
    <value>
      <thingCategories Inherit="False" />
      <tradeability>None</tradeability>
    </value>
  </Operation>
</Patch>
