# RimWorld mod .gitignore

# OS files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# IDE files
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.DotSettings
*.DotSettings.user
*.sln.iml

# Build artifacts
[Bb]in/
[Oo]bj/
*.pdb
*.mdb
*.cache

# Compiled assemblies are regenerated by MSBuild.
# Keep only the shipped mod DLL under versioned Assemblies folders.
*.dll
!**/Assemblies/*.dll

# Harmony is provided at runtime by the Harmony mod; do not bundle the NuGet copy
**/0Harmony.dll

# Temporary files
*.tmp
*.log

# NuGet packages
packages/
*.nupkg
*.snupkg
.nuget/

# Keep solution and project files
!*.sln
!*.csproj
